{
  "manifestVersion": 2,
  "pluginApi": "^1.0.0",
  "id": "dnd5e",
  "gameId": "dnd",
  "shortCode": "dnd5e",
  "version": "1.11.0",
  "order": 10,
  "defaultStatus": "published",
  "name": {
    "en": "Dungeons & Dragons — 5th Edition",
    "ru": "Dungeons & Dragons — 5-я редакция"
  },
  "description": {
    "en": "The classic 5e sheet: six abilities, skills and saves, spells, companions, inspiration and epic boons.",
    "ru": "Классический лист 5e: шесть характеристик, навыки и спасброски, заклинания, спутники, вдохновение и эпические дары."
  },
  "tags": ["d20", "fantasy", "5e"],
  "author": "Digital Character Sheets",
  "license": "MIT",
  "schemaVersion": 2,
  "game": {
    "id": "dnd",
    "order": 10,
    "name": {
      "en": "Dungeons & Dragons",
      "ru": "Dungeons & Dragons"
    },
    "description": {
      "en": "Heroic fantasy: classes, spells and d20 checks.",
      "ru": "Героическое фэнтези: классы, заклинания и проверки d20."
    }
  },
  "dependencies": {
    "host": "^1.0.0",
    "plugins": {}
  },
  "entry": {
    "module": "index.ts#dnd5eModule"
  },
  "sheet": {
    "mode": "custom",
    "client": "sheet.tsx",
    "createForm": "create-form.tsx"
  },
  "i18n": {
    "en": "i18n/en.json",
    "ru": "i18n/ru.json"
  },
  "demo": {
    "entry": "index.ts#createDemo"
  },
  "export": {
    "json": "index.ts#toPortableJson",
    "excel": "index.ts#buildExcelSections"
  },
  "derive": {
    "entry": "index.ts#deriveCharacter"
  },
  "derived": [
    "proficiencyBonus",
    "savingThrows[].value",
    "skills[].value",
    "spellSaveDifficulty",
    "spellcastingEntries[].attackBonus",
    "spellcastingEntries[].saveDC"
  ],
  "migrations": [
    {
      "from": 1,
      "to": 2,
      "entry": "index.ts#migrateDnd5eV1toV2",
      "description": "дискриминант редакции: systemId ставит хост, legacy edition убран",
      "removes": ["edition"]
    }
  ],
  "tests": {
    "conformance": ">=1"
  },
  "aliases": [
    {
      "gameSystem": "Dungeons & Dragons"
    }
  ],
  "ui": {
    "slots": [
      "HeaderActions",
      "HeaderSubtitle",
      "CompactNav",
      "CardSummary",
      "HouseRulesDialog",
      "BulkEditor"
    ],
    "entry": "ui.ts",
    "theme": {
      "tokens": {
        "light": {
          "primary": "355 62% 38%",
          "primary-foreground": "40 30% 97%",
          "accent": "30 45% 88%",
          "accent-foreground": "20 30% 15%",
          "border": "355 30% 80%",
          "ring": "355 62% 38%"
        },
        "dark": {
          "primary": "355 60% 60%",
          "primary-foreground": "20 20% 10%",
          "accent": "350 25% 30%",
          "accent-foreground": "40 30% 95%",
          "border": "350 20% 32%",
          "ring": "355 60% 60%"
        }
      },
      "font": "fonts.ts#pluginFont"
    }
  }
}
