{
  "manifestVersion": 2,
  "pluginApi": "^1.0.0",
  "id": "sandbox",
  "gameId": "sandbox",
  "shortCode": "sandbox",
  "version": "1.5.0",
  "order": 900,
  "defaultStatus": "test",
  "name": {
    "en": "Sandbox — Test Game",
    "ru": "Песочница — тестовая игра"
  },
  "description": {
    "en": "Live reference plugin: a small custom sheet, form, every UI slot, own CSS module, a scoped theme and all optional SDK entry points (derive, import, history, legacy import, embedded entity). Visible to testers and admins only (defaultStatus \"test\") — it exists to prove that a game needs nothing from the core.",
    "ru": "Живой эталон контракта: маленький собственный лист, форма, все UI-слоты, свой CSS-модуль, скоупленная тема и все необязательные точки SDK (derive, import, history, legacy-импорт, вложенная сущность). Видна только тестировщикам и админу (defaultStatus «test») — существует, чтобы доказывать: игре не нужно ничего от ядра."
  },
  "tags": ["sandbox", "test", "reference"],
  "author": "tests",
  "license": "MIT",
  "schemaVersion": 3,
  "game": {
    "id": "sandbox",
    "order": 900,
    "name": {
      "en": "Sandbox",
      "ru": "Песочница"
    },
    "description": {
      "en": "A test game for checking the plugin contract end to end.",
      "ru": "Тестовая игра для сквозной проверки контракта плагинов."
    }
  },
  "dependencies": {
    "host": "^1.0.0",
    "plugins": {}
  },
  "entry": {
    "module": "index.ts#sandboxModule"
  },
  "sheet": {
    "mode": "custom",
    "client": "sheet.tsx",
    "createForm": "create-form.tsx"
  },
  "i18n": {
    "en": "i18n/en.json",
    "ru": "i18n/ru.json"
  },
  "demo": {
    "entry": "index.ts#createDemo"
  },
  "export": {
    "json": "index.ts#toPortableJson",
    "excel": "index.ts#buildExcelSections"
  },
  "import": {
    "normalize": "index.ts#normalizeSandbox",
    "merge": "index.ts#mergeSandboxData"
  },
  "derive": {
    "entry": "index.ts#deriveCharacter"
  },
  "derived": ["total"],
  "migrations": [
    {
      "from": 1,
      "to": 2,
      "entry": "index.ts#migrateV1toV2",
      "description": "дискриминант редакции: systemId ставит хост",
      "removes": ["edition"]
    },
    {
      "from": 2,
      "to": 3,
      "entry": "index.ts#migrateV2toV3",
      "description": "производное total: сумма характеристик"
    }
  ],
  "tests": {
    "conformance": ">=1"
  },
  "ui": {
    "slots": [
      "HeaderActions",
      "HeaderSubtitle",
      "CompactNav",
      "BulkEditor",
      "CardSummary",
      "HouseRulesDialog"
    ],
    "entry": "ui.ts",
    "theme": {
      "tokens": {
        "light": {
          "background": "150 25% 97%",
          "foreground": "160 30% 12%",
          "card": "150 20% 99%",
          "card-foreground": "160 30% 12%",
          "primary": "150 45% 32%",
          "primary-foreground": "150 30% 98%",
          "accent": "150 30% 88%",
          "accent-foreground": "160 30% 15%",
          "muted": "150 15% 92%",
          "border": "150 18% 78%",
          "ring": "150 45% 32%",
          "radius": "0.25rem"
        },
        "dark": {
          "background": "160 20% 8%",
          "foreground": "150 20% 94%",
          "card": "160 18% 12%",
          "card-foreground": "150 20% 94%",
          "primary": "150 45% 58%",
          "primary-foreground": "160 30% 10%",
          "accent": "150 20% 24%",
          "accent-foreground": "150 30% 92%",
          "muted": "160 15% 18%",
          "border": "160 15% 28%",
          "ring": "150 45% 58%",
          "radius": "0.25rem"
        }
      },
      "font": "fonts.ts#pluginFont"
    }
  },
  "aliases": [
    {
      "gameSystem": "Sandbox — Test Game"
    }
  ]
}
