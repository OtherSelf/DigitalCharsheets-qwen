{
  "manifestVersion": 2,
  "pluginApi": "^1.0.0",
  "id": "dh1",
  "gameId": "darkHeresy",
  "shortCode": "dh1e",
  "version": "1.12.0",
  "order": 20,
  "defaultStatus": "published",
  "name": {
    "en": "Dark Heresy — 1st Edition",
    "ru": "Dark Heresy — 1-я редакция"
  },
  "description": {
    "en": "Classic Dark Heresy: nine characteristics, first-edition fatigue and career ranks.",
    "ru": "Классическая Dark Heresy: девять характеристик, усталость 1-й редакции и ранги карьеры."
  },
  "tags": ["warhammer40k", "d100", "grimdark"],
  "author": "Digital Character Sheets",
  "license": "MIT",
  "schemaVersion": 5,
  "game": {
    "id": "darkHeresy",
    "order": 20,
    "name": {
      "en": "Warhammer 40k: Dark Heresy",
      "ru": "Warhammer 40k: Dark Heresy"
    },
    "description": {
      "en": "Grimdark investigation in the Warhammer 40,000 universe.",
      "ru": "Мрачное расследование во вселенной Warhammer 40,000."
    }
  },
  "dependencies": {
    "host": "^1.0.0",
    "plugins": {}
  },
  "entry": {
    "module": "index.ts#dh1Module"
  },
  "sheet": {
    "mode": "custom",
    "client": "sheet.tsx",
    "createForm": "create-form.tsx"
  },
  "i18n": {
    "en": "i18n/en.json",
    "ru": "i18n/ru.json"
  },
  "demo": {
    "entry": "index.ts#createDemo"
  },
  "export": {
    "json": "index.ts#toPortableJson",
    "excel": "index.ts#buildExcelSections"
  },
  "derive": {
    "entry": "index.ts#deriveCharacter"
  },
  "derived": [
    "skills[].training.skilled",
    "skills[].training.plus10",
    "skills[].training.plus20",
    "skills[].training.plus30"
  ],
  "migrations": [
    {
      "from": 1,
      "to": 2,
      "entry": "index.ts#migrateDh1V1toV2",
      "description": "дискриминант редакции: systemId, legacy edition убран",
      "removes": ["edition"]
    },
    {
      "from": 2,
      "to": 3,
      "entry": "index.ts#migrateDh1V2toV3",
      "description": "поля 2-й редакции убраны, значения перенесены в notes",
      "removes": ["fatigue2nd"]
    },
    {
      "from": 3,
      "to": 4,
      "entry": "index.ts#migrateDh1V3toV4",
      "description": "состояния стали структурными записями conditions",
      "removes": []
    },
    {
      "from": 4,
      "to": 5,
      "entry": "index.ts#migrateDh1V4toV5",
      "description": "пол хранится каноническим кодом, старый текст в notes",
      "removes": []
    }
  ],
  "tests": {
    "conformance": ">=1"
  },
  "aliases": [
    {
      "gameSystem": "Dark Heresy",
      "edition": "1st"
    }
  ],
  "ui": {
    "slots": [
      "HeaderActions",
      "HeaderSubtitle",
      "CompactNav",
      "CardSummary",
      "HouseRulesDialog",
      "BulkEditor"
    ],
    "entry": "ui.ts",
    "theme": {
      "tokens": {
        "light": {
          "primary": "42 55% 31%",
          "primary-foreground": "40 40% 97%",
          "accent": "45 35% 86%",
          "accent-foreground": "30 25% 15%",
          "border": "40 22% 74%",
          "ring": "42 55% 31%",
          "radius": "0.375rem"
        },
        "dark": {
          "primary": "42 50% 62%",
          "primary-foreground": "30 20% 10%",
          "accent": "40 25% 26%",
          "accent-foreground": "45 35% 92%",
          "border": "40 15% 30%",
          "ring": "42 50% 62%",
          "radius": "0.375rem"
        }
      },
      "font": "fonts.ts#pluginFont"
    }
  }
}
