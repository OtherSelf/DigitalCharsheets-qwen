{
  "manifestVersion": 2,
  "pluginApi": "^1.0.0",
  "id": "dh2",
  "gameId": "darkHeresy",
  "version": "1.6.0",
  "order": 30,
  "defaultStatus": "published",
  "name": {
    "en": "Dark Heresy — 2nd Edition",
    "ru": "Dark Heresy — 2-я редакция"
  },
  "description": {
    "en": "Dark Heresy 2e: influence, the +30 column and second-edition fatigue.",
    "ru": "Dark Heresy 2e: влияние, колонка «+30» и усталость 2-й редакции."
  },
  "tags": ["warhammer40k", "d100", "grimdark"],
  "author": "Digital Character Sheets",
  "license": "MIT",
  "schemaVersion": 5,
  "game": {
    "id": "darkHeresy",
    "order": 20,
    "name": {
      "en": "Warhammer 40k: Dark Heresy",
      "ru": "Warhammer 40k: Dark Heresy"
    },
    "description": {
      "en": "Grimdark investigation in the Warhammer 40,000 universe.",
      "ru": "Мрачное расследование во вселенной Warhammer 40,000."
    }
  },
  "dependencies": {
    "host": "^1.0.0",
    "plugins": {}
  },
  "entry": {
    "module": "index.ts#dh2Module"
  },
  "sheet": {
    "mode": "custom",
    "client": "sheet.tsx",
    "createForm": "create-form.tsx"
  },
  "i18n": {
    "en": "i18n/en.json",
    "ru": "i18n/ru.json"
  },
  "demo": {
    "entry": "index.ts#createDemo"
  },
  "export": {
    "json": "index.ts#toPortableJson",
    "excel": "index.ts#buildExcelSections"
  },
  "derive": {
    "entry": "index.ts#deriveCharacter"
  },
  "derived": [
    "skills[].training.skilled",
    "skills[].training.plus10",
    "skills[].training.plus20",
    "skills[].training.plus30"
  ],
  "migrations": [
    {
      "from": 1,
      "to": 2,
      "entry": "index.ts#migrateDh2V1toV2",
      "description": "дискриминант редакции: systemId, legacy edition убран",
      "removes": ["edition"]
    },
    {
      "from": 2,
      "to": 3,
      "entry": "index.ts#migrateDh2V2toV3",
      "description": "2e-generation: поля DH1 в notes, появились influence и fatigue2nd",
      "removes": [
        "careerPath",
        "rank",
        "worldVariant",
        "quirk",
        "alternatePath",
        "advancedPath",
        "divinationEffect",
        "fatigue1st"
      ]
    },
    {
      "from": 3,
      "to": 4,
      "entry": "index.ts#migrateDh2V3toV4",
      "description": "состояния стали структурными записями conditions",
      "removes": []
    },
    {
      "from": 4,
      "to": 5,
      "entry": "index.ts#migrateDh2V4toV5",
      "description": "пол хранится каноническим кодом",
      "removes": []
    }
  ],
  "tests": {
    "conformance": ">=1"
  },
  "aliases": [
    {
      "gameSystem": "Dark Heresy",
      "edition": "2nd"
    }
  ],
  "ui": {
    "slots": [
      "HeaderActions",
      "HeaderSubtitle",
      "CompactNav",
      "CardSummary",
      "HouseRulesDialog",
      "BulkEditor"
    ],
    "entry": "ui.ts"
  }
}
