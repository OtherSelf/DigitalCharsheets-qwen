{
  "name": "digital-character-sheets",
  "version": "0.5.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "predev": "npm run plugins:generate",
    "dev": "next dev --turbopack",
    "prebuild": "npm run plugins:generate",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs",
    "test:dev": "node scripts/dev-smoke.mjs",
    "verify": "bash scripts/predeploy.sh",
    "plugins:generate": "node scripts/plugins/generate.mjs",
    "plugins:check": "node scripts/plugins/generate.mjs --check",
    "plugins:boundaries": "node scripts/plugins/check-boundaries.mjs",
    "test:visual": "bash scripts/visual.sh",
    "test:visual:full": "bash scripts/visual.sh",
    "test:visual:changed": "node scripts/visual-changed.mjs",
    "test:visual:prune": "node scripts/visual-prune.mjs",
    "test:visual:update": "bash scripts/visual.sh --update-snapshots",
    "test:visual:report": "playwright show-report",
    "test:visual:fast": "bash scripts/visual.sh --grep @fast",
    "plugins:conformance": "vitest run tests/unit/plugins-registry.test.ts tests/unit/plugin-slots.test.ts tests/unit/bulk-editor.test.ts tests/unit/example-plugin.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@scalar/nextjs-api-reference": "^0.12.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-themes": "^0.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "next": {
      "postcss": "8.5.32"
    },
    "glob": "14.0.4",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.6"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "readdirp": {
      "picomatch": "2.3.2"
    },
    "postcss-selector-parser": "6.1.5",
    "yaml": "2.9.1"
  }
}
