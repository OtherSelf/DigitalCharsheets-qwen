{
  "name": "digital-character-sheets",
  "version": "0.24.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "predev": "npm run plugins:generate && npm run docs:generate",
    "dev": "next dev --turbopack",
    "prebuild": "npm run plugins:generate && npm run docs:check",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "eol:check": "node scripts/check-eol.mjs",
    "eol:fix": "node scripts/check-eol.mjs --fix",
    "format": "npm run eol:fix && prettier --write .",
    "format:check": "npm run eol:check && prettier --check .",
    "legal:backfill": "node scripts/legal/backfill-divinations.mjs",
    "typecheck": "tsc --noEmit",
    "deadcode:check": "node scripts/quality/check-dead-code.mjs",
    "dedupe:check": "node scripts/quality/check-duplicates.mjs",
    "test": "vitest run",
    "test:plugin": "node scripts/tests/test-plugin.mjs",
    "test:layout": "node scripts/tests/check-test-layout.mjs",
    "plugins:doctor": "vitest run tests/unit/plugins-doctor.test.ts",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs",
    "bench": "vitest bench --run",
    "test:load": "node scripts/load.mjs",
    "test:race": "node scripts/race.mjs",
    "test:perf": "node scripts/perf-web.mjs",
    "check:build-id": "node scripts/check-build-id.mjs",
    "test:dev": "node scripts/dev-smoke.mjs",
    "test:stand": "node scripts/stand-smoke.mjs",
    "trash": "node scripts/trash.mjs",
    "verify": "bash scripts/predeploy.sh",
    "plugins:generate": "node scripts/plugins/generate.mjs",
    "plugins:scaffold": "node scripts/plugins/scaffold.mjs",
    "plugins:check": "node scripts/plugins/generate.mjs --check",
    "plugins:layout": "node scripts/plugins/check-layout.mjs",
    "docs:generate": "node scripts/docs/meta.mjs",
    "docs:check": "node scripts/docs/meta.mjs --check",
    "plugins:boundaries": "node scripts/plugins/check-boundaries.mjs",
    "plugins:purity": "node scripts/plugins/check-core-purity.mjs",
    "plugins:imports": "node scripts/plugins/check-core-imports.mjs",
    "test:visual": "bash scripts/visual.sh",
    "test:visual:plugin": "node scripts/tests/test-visual-plugin.mjs",
    "test:visual:full": "bash scripts/visual.sh",
    "test:visual:changed": "node scripts/visual-changed.mjs",
    "test:visual:prune": "node scripts/visual-prune.mjs",
    "test:visual:update": "bash scripts/visual.sh --update-snapshots",
    "test:visual:report": "playwright show-report",
    "test:visual:fast": "bash scripts/visual.sh --grep @fast",
    "plugins:conformance": "vitest run tests/unit/plugin-conformance.test.ts",
    "prestart": "npm run plugins:check",
    "postinstall": "node scripts/plugins/generate.mjs",
    "pretest": "node scripts/plugins/generate.mjs",
    "pretypecheck": "node scripts/plugins/generate.mjs",
    "predeadcode:check": "node scripts/plugins/generate.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^7.0.5",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@scalar/nextjs-api-reference": "^0.12.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "16.19.7",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-themes": "^0.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "autocannon": "^9.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jscpd": "^4.3.0",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "next": {
      "postcss": "8.5.32"
    },
    "glob": "14.0.4",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.6"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "readdirp": {
      "picomatch": "2.3.2"
    },
    "postcss-selector-parser": "6.1.5",
    "yaml": "2.9.1"
  }
}
